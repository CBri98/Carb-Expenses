{
  "name": "carbexpenses",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo del gestionale per le spese personali",
  "workspaces": [
    "apps/frontend",
    "apps/backend"
  ],
  "scripts": {
    "start:frontend": "npm run start --workspace @carbexpenses/frontend",
    "start:backend": "npm run start:dev --workspace @carbexpenses/backend",
    "build": "npm run build --workspaces --if-present",
    "build:frontend": "npm run build --workspace @carbexpenses/frontend",
    "build:backend": "npm run build --workspace @carbexpenses/backend",
    "test": "npm run test --workspaces --if-present",
    "test:frontend": "npm run test --workspace @carbexpenses/frontend",
    "test:e2e:reload": "npm run test:e2e:reload --workspace @carbexpenses/frontend",
    "test:backend": "npm run test --workspace @carbexpenses/backend",
    "lint": "eslint apps --max-warnings=0",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "typecheck:frontend": "npm run typecheck --workspace @carbexpenses/frontend",
    "typecheck:backend": "npm run typecheck --workspace @carbexpenses/backend",
    "prisma:generate": "npm run prisma:generate --workspace @carbexpenses/backend",
    "db:migrate": "npm run db:migrate --workspace @carbexpenses/backend",
    "db:seed": "npm run db:seed --workspace @carbexpenses/backend"
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  },
  "packageManager": "npm@11.13.0",
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "angular-eslint": "^22.0.0",
    "eslint": "^9.39.0",
    "typescript": "6.0.2",
    "typescript-eslint": "^8.46.0"
  }
}
